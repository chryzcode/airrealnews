# Air Real News (ARN) - Environment Configuration
NODE_ENV=production
PORT=5173

# Neon Postgres connection string (required). Get it from the Neon dashboard:
# https://console.neon.tech -> your project -> Connection string
DATABASE_URL=postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require

# Signing secret for auth tokens. Use a long random value in production.
ARN_JWT_SECRET=arn-secret-key-prod-2026-aerospace-global-newsroom

# Optional. When set, the /api/cron/ingest endpoint requires it as a Bearer
# token. Vercel Cron sends it automatically for scheduled invocations.
CRON_SECRET=
